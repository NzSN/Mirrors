{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mirrors.invalid/schema/reference-distribution-manifest-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "distributionId", "catalogSelectionRef", "profileId", "componentRefs", "buildInputs", "buildProvenance", "artifacts", "runtimeTrees", "hostRequirements", "publication"],
  "properties": {
    "schemaVersion": {"const": "mirrors.reference-distribution-manifest/v1"},
    "distributionId": {"$ref": "#/$defs/id"},
    "catalogSelectionRef": {"$ref": "#/$defs/catalogSelectionRef"},
    "profileId": {"$ref": "#/$defs/id"},
    "componentRefs": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/componentRef"}},
    "buildInputs": {"type": "array", "minItems": 3, "maxItems": 64, "items": {"type": "object", "additionalProperties": false, "required": ["inputId", "path", "bytes", "sha256"], "properties": {"inputId": {"$ref": "#/$defs/id"}, "path": {"$ref": "#/$defs/logicalPath"}, "bytes": {"type": "integer", "minimum": 1, "maximum": 4194304}, "sha256": {"$ref": "#/$defs/sha256"}}}},
    "buildProvenance": {"type": "object", "additionalProperties": false, "required": ["snapshotIndexSha256", "tools", "trees"], "properties": {"snapshotIndexSha256": {"$ref": "#/$defs/sha256"}, "tools": {"type": "array", "minItems": 2, "maxItems": 32, "items": {"type": "object", "additionalProperties": false, "required": ["toolId", "version", "bytes", "sha256"], "properties": {"toolId": {"$ref": "#/$defs/id"}, "version": {"type": "string", "minLength": 1, "maxLength": 512}, "bytes": {"type": "integer", "minimum": 1, "maximum": 536870912}, "sha256": {"$ref": "#/$defs/sha256"}}}}, "trees": {"type": "array", "minItems": 2, "maxItems": 32, "items": {"type": "object", "additionalProperties": false, "required": ["inputId", "algorithm", "digest", "entryCount", "bytes"], "properties": {"inputId": {"$ref": "#/$defs/id"}, "algorithm": {"const": "mirrors-runtime-tree-v1"}, "digest": {"$ref": "#/$defs/sha256"}, "entryCount": {"type": "integer", "minimum": 1, "maximum": 100000}, "bytes": {"type": "integer", "minimum": 1, "maximum": 2147483648}}}}}},
    "artifacts": {"type": "array", "minItems": 1, "maxItems": 1024, "items": {"$ref": "#/$defs/artifact"}},
    "runtimeTrees": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/runtimeTree"}},
    "hostRequirements": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/hostRequirement"}},
    "publication": {"const": "unclaimed"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+-]*$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitRevision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "logicalPath": {"type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^/]+(?:/[^/]+)*$"},
    "catalogSelectionRef": {"type": "object", "additionalProperties": false, "required": ["schemaVersion", "selectionKind", "selectionValue"], "properties": {"schemaVersion": {"const": "mirrors.framework-catalog/v1"}, "selectionKind": {"const": "sha256"}, "selectionValue": {"$ref": "#/$defs/sha256"}}},
    "dirtyContent": {"type": "object", "additionalProperties": false, "required": ["algorithm", "digest", "method", "includedPaths", "excludedPaths"], "properties": {"algorithm": {"const": "sha256"}, "digest": {"$ref": "#/$defs/sha256"}, "method": {"enum": ["git-diff-and-untracked-manifest-v1", "filesystem-tree-v1"]}, "includedPaths": {"type": "array", "maxItems": 4096, "uniqueItems": true, "items": {"$ref": "#/$defs/logicalPath"}}, "excludedPaths": {"type": "array", "maxItems": 4096, "items": {"type": "object", "additionalProperties": false, "required": ["path", "reasonCode"], "properties": {"path": {"$ref": "#/$defs/logicalPath"}, "reasonCode": {"enum": ["pre-existing-unrelated", "evidence-output", "build-output"]}}}}}},
    "componentRef": {"type": "object", "additionalProperties": false, "required": ["componentId", "repository", "revision", "dirty"], "properties": {"componentId": {"$ref": "#/$defs/id"}, "repository": {"type": "string", "minLength": 1, "maxLength": 1024}, "revision": {"$ref": "#/$defs/gitRevision"}, "dirty": {"type": "boolean"}, "dirtyContent": {"$ref": "#/$defs/dirtyContent"}}, "allOf": [{"if": {"properties": {"dirty": {"const": true}}}, "then": {"required": ["dirtyContent"]}}, {"if": {"properties": {"dirty": {"const": false}}}, "then": {"not": {"required": ["dirtyContent"]}}}]},
    "artifact": {"type": "object", "additionalProperties": false, "required": ["artifactId", "path", "kind", "mediaType", "bytes", "sha256", "mode", "source"], "properties": {"artifactId": {"$ref": "#/$defs/id"}, "path": {"$ref": "#/$defs/logicalPath"}, "kind": {"enum": ["file", "archive"]}, "mediaType": {"type": "string", "minLength": 1, "maxLength": 256}, "bytes": {"type": "integer", "minimum": 0, "maximum": 536870912}, "sha256": {"$ref": "#/$defs/sha256"}, "mode": {"enum": ["0644", "0755"]}, "source": {"type": "object", "additionalProperties": false, "required": ["kind", "id"], "properties": {"kind": {"enum": ["component-build", "dependency-lock"]}, "id": {"$ref": "#/$defs/id"}}}, "dynamicLibraries": {"type": "array", "maxItems": 64, "items": {"type": "object", "additionalProperties": false, "required": ["soname", "path", "sha256"], "properties": {"soname": {"type": "string", "minLength": 1, "maxLength": 256}, "path": {"type": "string", "minLength": 1, "maxLength": 1024}, "sha256": {"$ref": "#/$defs/sha256"}}}}}},
    "runtimeTree": {"type": "object", "additionalProperties": false, "required": ["treeId", "sourceArtifactId", "selectionId", "path", "algorithm", "digest", "entryCount", "bytes"], "properties": {"treeId": {"$ref": "#/$defs/id"}, "sourceArtifactId": {"$ref": "#/$defs/id"}, "selectionId": {"$ref": "#/$defs/id"}, "path": {"$ref": "#/$defs/logicalPath"}, "algorithm": {"const": "mirrors-runtime-tree-v1"}, "digest": {"$ref": "#/$defs/sha256"}, "entryCount": {"type": "integer", "minimum": 1, "maximum": 100000}, "bytes": {"type": "integer", "minimum": 1, "maximum": 2147483648}}},
    "hostRequirement": {"type": "object", "additionalProperties": false, "required": ["id"], "minProperties": 2, "properties": {"id": {"$ref": "#/$defs/id"}, "minimumVersion": {"type": "string", "minLength": 1, "maxLength": 256}, "requirement": {"type": "string", "minLength": 1, "maxLength": 1024}, "observedVersion": {"type": "string", "minLength": 1, "maxLength": 256}}}
  }
}
