{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mirrors.invalid/schema/bundle-index-v1.schema.json",
  "title": "Mirrors finalized evidence bundle index v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "state", "jsonEncoding", "records"],
  "properties": {
    "schemaVersion": {"const": "mirrors.evidence-bundle-index/v1"},
    "runId": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "state": {"const": "finalized"},
    "jsonEncoding": {"const": "mirrors-evidence-json/v1"},
    "records": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2047,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "path", "bytes", "sha256", "visibility", "required"],
        "properties": {
          "role": {"enum": ["private-envelope", "public-summary", "payload"]},
          "artifactId": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
          "path": {"type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[\\u0000-\\u001f\\u007f])[^/]+(?:/[^/]+)*$"},
          "bytes": {"type": "integer", "minimum": 0, "maximum": 67108864},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "visibility": {"enum": ["public", "private"]},
          "required": {"type": "boolean"}
        },
        "allOf": [
          {"if": {"properties": {"role": {"const": "payload"}}}, "then": {"required": ["artifactId"]}},
          {"if": {"properties": {"role": {"enum": ["private-envelope", "public-summary"]}}}, "then": {"not": {"required": ["artifactId"]}}}
        ]
      }
    }
  }
}
