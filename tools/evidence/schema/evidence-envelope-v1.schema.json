{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mirrors.invalid/schema/evidence-envelope-v1.schema.json",
  "title": "Mirrors private durable evidence envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "projectionKind",
    "runId",
    "releaseProfile",
    "catalogSelectionRef",
    "components",
    "timestamps",
    "environment",
    "commands",
    "tiers",
    "artifacts",
    "producerResults",
    "releaseRequirements",
    "outcomes",
    "qualification",
    "retention"
  ],
  "properties": {
    "schemaVersion": {"const": "mirrors.evidence-envelope/v1.0"},
    "projectionKind": {"const": "private"},
    "runId": {"$ref": "#/$defs/opaqueId"},
    "releaseProfile": {"const": "mirrors.local-release-evidence/v1"},
    "catalogSelectionRef": {"$ref": "#/$defs/catalogSelectionRef"},
    "components": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"$ref": "#/$defs/componentRef"}
    },
    "timestamps": {"$ref": "#/$defs/timestamps"},
    "environment": {"$ref": "#/$defs/privateEnvironment"},
    "commands": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {"$ref": "#/$defs/privateCommand"}
    },
    "tiers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {"$ref": "#/$defs/tierResult"}
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2045,
      "items": {"$ref": "#/$defs/artifactRef"}
    },
    "producerResults": {
      "type": "array",
      "maxItems": 256,
      "items": {"$ref": "#/$defs/producerResultRef"}
    },
    "releaseRequirements": {"$ref": "#/$defs/releaseRequirements"},
    "outcomes": {"$ref": "#/$defs/outcomes"},
    "qualification": {"$ref": "#/$defs/qualification"},
    "retention": {"$ref": "#/$defs/retention"},
    "privateMetadata": {"$ref": "#/$defs/privateMetadata"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitRevision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "opaqueId": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "logicalPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "allOf": [
        {"pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[\\u0000-\\u001f\\u007f])[^/]+(?:/[^/]+)*$"}
      ]
    },
    "schemaName": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[a-z0-9][a-z0-9._-]*(?:/[A-Za-z0-9._-]+)+$"},
    "catalogSelectionRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "selectionKind", "selectionValue"],
      "properties": {
        "schemaVersion": {"const": "mirrors.framework-catalog/v1"},
        "selectionKind": {"enum": ["sha256", "git-revision"]},
        "selectionValue": {"type": "string"}
      },
      "allOf": [
        {"if": {"properties": {"selectionKind": {"const": "sha256"}}}, "then": {"properties": {"selectionValue": {"$ref": "#/$defs/sha256"}}}},
        {"if": {"properties": {"selectionKind": {"const": "git-revision"}}}, "then": {"properties": {"selectionValue": {"$ref": "#/$defs/gitRevision"}}}}
      ]
    },
    "runRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "runId", "envelopeSha256", "projectionKind"],
      "properties": {
        "schemaVersion": {"enum": ["mirrors.evidence-envelope/v1.0", "mirrors.evidence-public-summary/v1.0"]},
        "runId": {"$ref": "#/$defs/opaqueId"},
        "envelopeSha256": {"$ref": "#/$defs/sha256"},
        "projectionKind": {"enum": ["private", "public"]}
      },
      "oneOf": [
        {"properties": {"schemaVersion": {"const": "mirrors.evidence-envelope/v1.0"}, "projectionKind": {"const": "private"}}},
        {"properties": {"schemaVersion": {"const": "mirrors.evidence-public-summary/v1.0"}, "projectionKind": {"const": "public"}}}
      ]
    },
    "excludedPath": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "reasonCode"],
      "properties": {
        "path": {"$ref": "#/$defs/logicalPath"},
        "reasonCode": {"enum": ["pre-existing-unrelated", "evidence-output", "build-output"]}
      }
    },
    "dirtyContent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "digest", "method", "includedPaths", "excludedPaths"],
      "properties": {
        "algorithm": {"const": "sha256"},
        "digest": {"$ref": "#/$defs/sha256"},
        "method": {"enum": ["git-diff-and-untracked-manifest-v1", "filesystem-tree-v1"]},
        "includedPaths": {
          "type": "array",
          "maxItems": 4096,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/logicalPath"}
        },
        "excludedPaths": {
          "type": "array",
          "maxItems": 4096,
          "items": {"$ref": "#/$defs/excludedPath"}
        }
      }
    },
    "componentRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["componentId", "repository", "revision", "dirty"],
      "properties": {
        "componentId": {"$ref": "#/$defs/opaqueId"},
        "repository": {"type": "string", "minLength": 1, "maxLength": 1024},
        "revision": {"$ref": "#/$defs/gitRevision"},
        "dirty": {"type": "boolean"},
        "dirtyContent": {"$ref": "#/$defs/dirtyContent"}
      },
      "allOf": [
        {"if": {"properties": {"dirty": {"const": true}}}, "then": {"required": ["dirtyContent"]}},
        {"if": {"properties": {"dirty": {"const": false}}}, "then": {"not": {"required": ["dirtyContent"]}}}
      ]
    },
    "bundleLocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path"],
      "properties": {"kind": {"const": "bundle"}, "path": {"$ref": "#/$defs/logicalPath"}}
    },
    "externalLocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "immutableUri"],
      "properties": {
        "kind": {"const": "external"},
        "immutableUri": {"type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^(?:https://|urn:)[^\\s]+$"}
      }
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactId", "mediaType", "role", "bytes", "sha256", "visibility", "requirement", "location"],
      "properties": {
        "artifactId": {"$ref": "#/$defs/opaqueId"},
        "mediaType": {"type": "string", "minLength": 1, "maxLength": 256},
        "role": {"enum": ["command-log", "cleanup-receipt", "producer-result", "distribution-manifest", "cache-index", "diagnostic", "reproduction-input", "recovery-receipt"]},
        "bytes": {"type": "integer", "minimum": 0, "maximum": 67108864},
        "sha256": {"$ref": "#/$defs/sha256"},
        "visibility": {"enum": ["public", "private"]},
        "requirement": {"enum": ["required", "optional"]},
        "location": {"oneOf": [{"$ref": "#/$defs/bundleLocation"}, {"$ref": "#/$defs/externalLocation"}]}
      }
    },
    "producerResultRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["producer", "schemaVersion", "artifactId"],
      "properties": {
        "producer": {"$ref": "#/$defs/opaqueId"},
        "schemaVersion": {"$ref": "#/$defs/schemaName"},
        "artifactId": {"$ref": "#/$defs/opaqueId"}
      }
    },
    "timestamps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startedAtUtc", "finishedAtUtc", "monotonicDurationNs"],
      "properties": {
        "startedAtUtc": {"type": "string", "format": "date-time", "pattern": "Z$"},
        "finishedAtUtc": {"type": "string", "format": "date-time", "pattern": "Z$"},
        "monotonicDurationNs": {"type": "integer", "minimum": 0}
      }
    },
    "toolIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"$ref": "#/$defs/opaqueId"},
        "version": {"type": "string", "minLength": 1, "maxLength": 256},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "privateEnvironment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platformProfile", "os", "architecture", "tools"],
      "properties": {
        "platformProfile": {"$ref": "#/$defs/opaqueId"},
        "os": {"type": "string", "minLength": 1, "maxLength": 256},
        "architecture": {"type": "string", "minLength": 1, "maxLength": 64},
        "kernel": {"type": "string", "minLength": 1, "maxLength": 512},
        "workingDirectory": {"type": "string", "minLength": 1, "maxLength": 4096},
        "tools": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/toolIdentity"}}
      }
    },
    "privateCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commandId", "tierId", "requirement", "argv", "cwd", "exit"],
      "properties": {
        "commandId": {"$ref": "#/$defs/opaqueId"},
        "tierId": {"$ref": "#/$defs/opaqueId"},
        "requirement": {"enum": ["required", "optional"]},
        "argv": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"type": "string", "maxLength": 4096}},
        "cwd": {"type": "string", "minLength": 1, "maxLength": 4096},
        "exit": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": {"enum": ["code", "signal", "not-started"]},
            "code": {"type": "integer", "minimum": 0, "maximum": 255},
            "signal": {"type": "string", "pattern": "^SIG[A-Z0-9]+$"}
          },
          "oneOf": [
            {"properties": {"kind": {"const": "code"}}, "required": ["code"], "not": {"required": ["signal"]}},
            {"properties": {"kind": {"const": "signal"}}, "required": ["signal"], "not": {"required": ["code"]}},
            {"properties": {"kind": {"const": "not-started"}}, "not": {"anyOf": [{"required": ["code"]}, {"required": ["signal"]}]}}
          ]
        },
        "logArtifactId": {"$ref": "#/$defs/opaqueId"}
      }
    },
    "tierResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tierId", "requirement", "status", "artifactIds"],
      "properties": {
        "tierId": {"$ref": "#/$defs/opaqueId"},
        "requirement": {"enum": ["required", "optional"]},
        "status": {"enum": ["passed", "failed", "skipped", "unavailable", "blocked", "not_run"]},
        "reasonCode": {"$ref": "#/$defs/opaqueId"},
        "artifactIds": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/opaqueId"}}
      }
    },
    "behaviorOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "classification"],
      "properties": {
        "status": {"enum": ["passed", "failed", "inconclusive", "not_run"]},
        "classification": {
          "type": "object",
          "additionalProperties": false,
          "required": ["namespace", "code"],
          "properties": {"namespace": {"$ref": "#/$defs/opaqueId"}, "code": {"$ref": "#/$defs/opaqueId"}}
        },
        "producerResult": {"$ref": "#/$defs/producerResultRef"}
      }
    },
    "cleanupOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "requirement", "status", "artifactIds"],
      "properties": {
        "scope": {"enum": ["local-cooperative", "gate-physical", "gate-recovery"]},
        "requirement": {"enum": ["required", "optional", "not-applicable"]},
        "status": {"enum": ["confirmed", "failed", "unconfirmed", "not_applicable"]},
        "reasonCode": {"$ref": "#/$defs/opaqueId"},
        "artifactIds": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/opaqueId"}}
      },
      "allOf": [
        {"if": {"properties": {"requirement": {"const": "not-applicable"}}}, "then": {"properties": {"status": {"const": "not_applicable"}}}},
        {"if": {"properties": {"status": {"const": "not_applicable"}}}, "then": {"properties": {"requirement": {"const": "not-applicable"}}}}
      ]
    },
    "persistenceOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirement", "status", "requiredArtifactIds", "missingArtifactIds"],
      "properties": {
        "requirement": {"enum": ["required", "optional", "not-requested"]},
        "status": {"enum": ["complete", "incomplete", "failed", "not_requested"]},
        "reasonCode": {"$ref": "#/$defs/opaqueId"},
        "requiredArtifactIds": {"type": "array", "maxItems": 2048, "uniqueItems": true, "items": {"$ref": "#/$defs/opaqueId"}},
        "missingArtifactIds": {"type": "array", "maxItems": 2048, "uniqueItems": true, "items": {"$ref": "#/$defs/opaqueId"}}
      },
      "allOf": [
        {"if": {"properties": {"status": {"const": "complete"}}}, "then": {"properties": {"missingArtifactIds": {"maxItems": 0}}}},
        {"if": {"properties": {"requirement": {"const": "not-requested"}}}, "then": {"properties": {"status": {"const": "not_requested"}}}}
      ]
    },
    "outcomes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["behavior", "cleanup", "persistence"],
      "properties": {
        "behavior": {"$ref": "#/$defs/behaviorOutcome"},
        "cleanup": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/cleanupOutcome"}},
        "persistence": {"$ref": "#/$defs/persistenceOutcome"}
      }
    },
    "releaseRequirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiredArtifactIds", "requiredStructuralRoles", "requiredCleanupScopes"],
      "properties": {
        "requiredArtifactIds": {"type": "array", "minItems": 1, "maxItems": 2048, "uniqueItems": true, "items": {"$ref": "#/$defs/opaqueId"}},
        "requiredStructuralRoles": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {"enum": ["public-summary", "private-index"]},
          "allOf": [
            {"contains": {"const": "public-summary"}},
            {"contains": {"const": "private-index"}}
          ]
        },
        "requiredCleanupScopes": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"enum": ["local-cooperative", "gate-physical", "gate-recovery"]}}
      }
    },
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reasonCodes"],
      "properties": {
        "status": {"enum": ["qualified", "not_qualified", "incomplete"]},
        "reasonCodes": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/opaqueId"}}
      }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "automaticUpload", "automaticPruning"],
      "properties": {
        "profile": {"const": "local-owner-only-v1"},
        "automaticUpload": {"const": false},
        "automaticPruning": {"const": false}
      }
    },
    "privateMetadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "canary": {"type": "string", "pattern": "^MIRRORS_PRIVATE_CANARY_[A-Za-z0-9._-]+$"},
        "privatePaths": {"type": "array", "maxItems": 256, "items": {"type": "string", "maxLength": 4096}},
        "operatorNotes": {"type": "array", "maxItems": 256, "items": {"type": "string", "maxLength": 4096}}
      }
    }
  }
}
