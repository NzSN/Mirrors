    {
      "name": "public-private-canary-repository",
      "base": "public-summary.valid.json",
      "operation": "set",
      "path": ["components", 0, "repository"],
      "value": "https://example.invalid/MIRRORS_PRIVATE_CANARY_REPOSITORY"
    },
    {
      "name": "public-private-canary-os",
      "base": "public-summary.valid.json",
      "operation": "set",
      "path": ["environment", "os"],
      "value": "MIRRORS_PRIVATE_CANARY_OS"
    },
    {
      "name": "public-private-canary-tool-version",
      "base": "public-summary.valid.json",
      "operation": "set",
      "path": ["environment", "tools", 0, "version"],
      "value": "MIRRORS_PRIVATE_CANARY_TOOL"
    },
    {
      "name": "public-private-canary-approved-argument",
      "base": "public-summary.valid.json",
      "operation": "set",
      "path": ["commands", 0, "approvedArgs"],
