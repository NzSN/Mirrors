    {
      "name": "unknown-major-version",
      "base": "envelope-private.valid.json",
      "operation": "set",
      "path": ["schemaVersion"],
      "value": "mirrors.evidence-envelope/v2.0"
    },
    {
      "name": "complete-with-missing-required-artifact",
