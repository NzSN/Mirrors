    "engine": {
      "enum": [
        "mirrors",
        "sany",
        "apalache"
      ]
    },
    "provider": {
      "enum": [
        "borrowed-directory",
        "inline-source-map"
      ]
    },
    "inputDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string"
