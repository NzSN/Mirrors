        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "execution": {
            "not": {
              "const": "completed"
            }
          }
        }
      },
      "then": {
        "properties": {
          "outcome": {
            "const": "unknown"
          }
        }
      }
    }
  ]
