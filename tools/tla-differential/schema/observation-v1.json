{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mirrors.tla-differential-observation/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "fixture",
    "engine",
    "provider",
    "inputDigest",
