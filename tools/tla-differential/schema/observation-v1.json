                    "properties": {
                      "owner": {
                        "type": "string",
                        "minLength": 1
                      },
                      "name": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "module": {
                        "type": "string",
                        "minLength": 1
                      },
                      "local": {
                        "type": "boolean"
                      },
                      "line": {
                        "type": "integer",
