                                {
                                  "type": "object",
                                  "additionalProperties": false,
                                  "required": [
                                    "kind",
                                    "value"
                                  ],
                                  "properties": {
                                    "kind": {
                                      "const": "string"
                                    },
                                    "value": {
                                      "type": "string"
                                    }
                                  }
                                },
                                {
                                  "type": "object",
                                  "additionalProperties": false,
                                  "required": [
                                    "kind",
                                    "value"
                                  ],
                                  "properties": {
                                    "kind": {
                                      "const": "integer"
                                    },
                                    "value": {
                                      "type": "integer"
                                    }
                                  }
                                },
                                {
                                  "type": "object",
                                  "additionalProperties": false,
                                  "required": [
                                    "kind",
                                    "value"
                                  ],
                                  "properties": {
                                    "kind": {
                                      "const": "boolean"
                                    },
                                    "value": {
                                      "type": "boolean"
                                    }
                                  }
                                }
                              ]
                            },
                            "implicit": {
                              "type": "boolean"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          ]
        }
      }
