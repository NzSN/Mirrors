-function(writesentry_check_generated_interface source_dir)
-  file(READ "${source_dir}/model-interface/manifest.json" generated_manifest)
-  string(JSON schema GET "${generated_manifest}" schema)
-  if(NOT schema STREQUAL "writesentry-generated-interface/v1")
-    message(FATAL_ERROR "Unexpected generated-interface manifest schema")
-  endif()
-  string(JSON count LENGTH "${generated_manifest}" files)
-  math(EXPR last "${count} - 1")
-  foreach(index RANGE 0 ${last})
-    string(JSON relative MEMBER "${generated_manifest}" files ${index})
-    if(IS_ABSOLUTE "${relative}" OR relative MATCHES "(^|/)\\.\\.(/|$)")
-      message(FATAL_ERROR "Invalid generated-interface artifact path")
-    endif()
-    string(JSON expected GET "${generated_manifest}" files "${relative}")
-    file(SHA256 "${source_dir}/${relative}" actual)
-    if(NOT actual STREQUAL expected)
-      message(FATAL_ERROR "Generated interface is stale or modified: ${relative}")
-    endif()
-  endforeach()
-  file(READ "${source_dir}/model-interface/WriteSentry.mirror-interface.lock.json" lock)
-  file(READ "${source_dir}/tests/mbt/generated/.model-interface-generated.json" metadata)
-  string(JSON lock_digest GET "${lock}" semanticDigest)
-  string(JSON generated_digest GET "${metadata}" semanticDigest)
-  string(JSON manifest_digest GET "${generated_manifest}" semantic_digest)
-  if(NOT lock_digest STREQUAL generated_digest OR
-     NOT lock_digest STREQUAL manifest_digest)
-    message(FATAL_ERROR "Generated interface digest disagrees with its reviewed lock")
-  endif()
-endfunction()
