+++ b/test/portability/socket_smoke.cpp
@@ -0,0 +1,83 @@
+#include <mirrorcpp/mirrorcpp.hpp>
+#include "detail/net.hpp"
+#include <atomic>
+#include <chrono>
+#include <cstring>
+#include <iostream>
+#include <thread>
+#ifdef _WIN32
+#include <winsock2.h>
+#include <ws2tcpip.h>
+using RawSocket = SOCKET;
+constexpr RawSocket invalid_socket = INVALID_SOCKET;
+static void close_socket(RawSocket fd) { ::closesocket(fd); }
+using SockLength = int;
+#else
+#include <arpa/inet.h>
+#include <sys/socket.h>
+#include <unistd.h>
+using RawSocket = int;
+constexpr RawSocket invalid_socket = -1;
+static void close_socket(RawSocket fd) { ::close(fd); }
+using SockLength = socklen_t;
+#endif
+
+int main() {
+  static_assert(sizeof(mirrorcpp::detail::Socket::native_handle_type) >= sizeof(void*));
+#ifdef _WIN32
+  WSADATA wsa{};
+  if (::WSAStartup(MAKEWORD(2, 2), &wsa) != 0) return 1;
+#endif
+  const RawSocket listener = ::socket(AF_INET, SOCK_STREAM, 0);
+  if (listener == invalid_socket) return 2;
+  sockaddr_in address{};
+  address.sin_family = AF_INET;
+  address.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+  address.sin_port = 0;
+  if (::bind(listener, reinterpret_cast<sockaddr*>(&address), sizeof address) != 0 ||
+      ::listen(listener, 1) != 0) return 3;
+  SockLength length = sizeof address;
+  if (::getsockname(listener, reinterpret_cast<sockaddr*>(&address), &length) != 0) return 4;
+  std::atomic<bool> server_ok{true};
+  std::jthread server([&] {
+    const RawSocket peer = ::accept(listener, nullptr, nullptr);
+    if (peer == invalid_socket) { server_ok = false; return; }
+    char input[32]{};
+    int size = 0;
+    while (size < 6) {
+      const int n = static_cast<int>(::recv(peer, input + size, 6 - size, 0));
+      if (n <= 0) { server_ok = false; close_socket(peer); return; }
+      size += n;
+    }
+    if (std::string(input, 6) != "hello\n") server_ok = false;
+    for (const char* chunk : {"first\nsec", "ond\npartial"}) {
+      int sent = 0;
+      const int count = static_cast<int>(std::strlen(chunk));
+      while (sent < count) {
+        const int n = static_cast<int>(::send(peer, chunk + sent, count - sent, 0));
+        if (n <= 0) { server_ok = false; close_socket(peer); return; }
+        sent += n;
+      }
+      std::this_thread::sleep_for(std::chrono::milliseconds(10));
+    }
+    close_socket(peer);
+  });
+  auto connected = mirrorcpp::connect_tcp("127.0.0.1", ntohs(address.sin_port),
+      mirrorcpp::ConnectOptions{std::chrono::milliseconds(1000)});
+  if (!connected) { close_socket(listener); return 5; }
+  auto client = std::move(*connected);
+  const auto sent = client->send_line("hello");
+  const auto first = client->recv_line();
+  const auto second = client->recv_line();
+  const auto partial = client->recv_line();
+  const bool ok = sent && first && *first == "first" && second && *second == "second" &&
+                  !partial && partial.error().kind == mirrorcpp::ErrorKind::io;
+  (void)client->close();
+  server.join();
+  close_socket(listener);
+#ifdef _WIN32
+  ::WSACleanup();
+#endif
+  if (!ok || !server_ok) return 6;
+  std::cout << "NATIVE SOCKET FRAMING GREEN\n";
+}
