+inline Result<std::string> read_line_from_fd(long fd, std::string& buf,
+                                             const char* unexpected_eof_msg) {
+  return read_line_from_source([fd](char* data, std::size_t capacity) -> Result<std::size_t> {
+#ifdef _WIN32
+    int count;
+    do {
+      count = ::_read(static_cast<int>(fd), data, static_cast<unsigned>(capacity));
+    } while (count < 0 && errno == EINTR);
+#else
+    ssize_t count;
+    do {
+      count = ::read(fd, data, capacity);
+    } while (count < 0 && errno == EINTR);
+#endif
+    if (count < 0)
+      return unexpected(Error(ErrorKind::io, std::string("read failed: ") + std::strerror(errno)));
+    return static_cast<std::size_t>(count);
+  }, buf, unexpected_eof_msg);
+}
